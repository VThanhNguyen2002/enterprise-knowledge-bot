# ── LLM & Embedding API Keys ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here   # Optional — embeddings run offline

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# ── Embedding Configuration ───────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_data

# ── RAG Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=2

# ── Security / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8501

# ── Service URLs (used by Streamlit frontend) ─────────────────────────────────
# Local development: http://localhost:8000
# Docker Compose:    http://ekb-backend:8000
API_BASE_URL=http://localhost:8000

# ── Redis (Message Broker + Semantic Cache) ───────────────────────────────────
# Local development: redis://localhost:6379/0
# Docker Compose:    redis://redis:6379/0  (auto-set in docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1

# ── Supply Chain Security ─────────────────────────────────────────────────────
# Controls the `safety` CVE audit step in the Docker build.
# Options: scan (default — fails build on critical CVEs) | skip (dev/local only)
SAFETY_LEVEL=scan